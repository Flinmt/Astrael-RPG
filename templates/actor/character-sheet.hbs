              {{else}}
              <button type="button" class="astrael-characteristic-add" disabled><i class="fas fa-plus" aria-hidden="true"></i>{{#if characterCharacteristics.isFlaw}}{{localize "ASTRAEL.CharacterCharacteristics.AddFlaw"}}{{else}}{{localize "ASTRAEL.CharacterCharacteristics.AddAdvantage"}}{{/if}}</button>
