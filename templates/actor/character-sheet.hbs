                  <span class="astrael-character-dial-segment segment-1"></span><span class="astrael-character-dial-segment segment-2"></span><span class="astrael-character-dial-segment segment-3"></span><span class="astrael-character-dial-segment segment-4"></span><span class="astrael-character-dial-segment segment-5"></span>
                  <i class="fas fa-bolt" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-character-attribute-roll" href="#" data-type="attribute" data-key="wits" title="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Wits'}}" aria-label="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Wits'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-character-attribute">
                <button class="astrael-character-attribute-dial level-{{system.attributes.resolve.value}}" type="button" data-action="adjust-character-attribute" data-key="resolve" data-name="system.attributes.resolve.value" data-value="{{system.attributes.resolve.value}}" title="{{localize 'ASTRAEL.Attribute.Resolve'}} · {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.resolve.value}} · {{localize 'ASTRAEL.CharacterAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Resolve'}}, {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.resolve.value}}">
                  <span class="astrael-character-dial-segment segment-1"></span><span class="astrael-character-dial-segment segment-2"></span><span class="astrael-character-dial-segment segment-3"></span><span class="astrael-character-dial-segment segment-4"></span><span class="astrael-character-dial-segment segment-5"></span>
