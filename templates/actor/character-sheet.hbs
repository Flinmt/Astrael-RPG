                {{else}}
                <button type="button" class="astrael-character-characteristic-remove" disabled aria-label="{{localize 'ASTRAEL.CharacterSkills.Remove'}}: {{entry.name}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
