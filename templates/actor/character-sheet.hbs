              <button type="button" data-action="cancel-characteristic-removal">{{localize "ASTRAEL.CharacterSkills.Cancel"}}</button>
              <button type="button" class="is-danger" data-action="confirm-remove-characteristic">{{localize "ASTRAEL.CharacterSkills.Remove"}}</button>
            </div>
          </section>
