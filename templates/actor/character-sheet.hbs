                {{else}}
                <button type="button" class="astrael-character-characteristic-open" disabled aria-label="{{localize 'ASTRAEL.CharacterSkills.Edit'}}: {{entry.name}}"><i class="fas fa-pen" aria-hidden="true"></i></button>
