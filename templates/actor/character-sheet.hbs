            <div class="astrael-ascension-details">
              <label class="astrael-ascension-goal is-ambition">
                <span><i class="fas fa-crown" aria-hidden="true"></i>{{localize "ASTRAEL.CharacterDetails.Ambition"}}</span>
                <input name="system.details.ambition" type="text" value="{{system.details.ambition}}" placeholder="{{localize 'ASTRAEL.CharacterDetails.AmbitionPlaceholder'}}">
              </label>
              <label class="astrael-ascension-goal is-desire">
                <span><i class="fas fa-compass" aria-hidden="true"></i>{{localize "ASTRAEL.CharacterDetails.Desire"}}</span>
                <input name="system.details.desire" type="text" value="{{system.details.desire}}" placeholder="{{localize 'ASTRAEL.CharacterDetails.DesirePlaceholder'}}">
              </label>
            </div>
            <header class="astrael-ascension-header">
              <div>
                <span aria-hidden="true"></span>
                <h2 class="astrael-character-section-title">{{localize "ASTRAEL.Tab.Ascension"}}</h2>
              </div>
            </header>
            <section class="astrael-ascension-summary" aria-label="{{localize 'ASTRAEL.Experience.Summary'}}">
              <article class="is-current">
                <span>{{localize "ASTRAEL.Experience.Current"}}</span>
                <strong>{{characterExperience.current}}</strong>
              </article>
              <article class="is-spent">
                <label for="xp-spent-{{actor.id}}">{{localize "ASTRAEL.Experience.Spent"}}</label>
                {{#if characterExperience.canEditSpent}}
                <div class="astrael-ascension-spent-control">
                  <i class="fas fa-coins" aria-hidden="true"></i>
                  <input id="xp-spent-{{actor.id}}" type="number" min="0" max="{{characterExperience.total}}" step="1" value="{{characterExperience.spent}}" data-action="set-xp-spent">
                </div>
                {{else}}
                <strong>{{characterExperience.spent}}</strong>
                {{/if}}
              </article>
              <article class="is-total">
                <span>{{localize "ASTRAEL.Experience.Total"}}</span>
                <strong>{{characterExperience.total}}</strong>
              </article>
            </section>
            <section class="astrael-ascension-history" aria-label="{{localize 'ASTRAEL.Experience.History'}}">
              <header>
                <i class="fas fa-clock-rotate-left" aria-hidden="true"></i>
                <h3>{{localize "ASTRAEL.Experience.History"}}</h3>
              </header>
              <div class="astrael-ascension-history-list">
                {{#each characterExperience.entries as |entry|}}
                <article class="astrael-ascension-history-entry">
                  <strong>+{{entry.amount}} XP</strong>
                  <span>{{entry.description}}</span>
                </article>
                {{/each}}
                {{#unless characterExperience.entries.length}}
                <div class="astrael-ascension-history-empty">
                  <i class="fas fa-scroll" aria-hidden="true"></i>
                  <span>{{localize "ASTRAEL.Experience.EmptyHistory"}}</span>
                </div>
                {{/unless}}
              </div>
            </section>
          </section>
        </div>
        <div class="tab-panel astrael-character-panel" data-tab="settings">
          <section class="astrael-character-settings">
            <header class="astrael-character-settings-header">
              <div>
                <span aria-hidden="true"></span>
                <h2 class="astrael-character-section-title">{{localize "ASTRAEL.Tab.Settings"}}</h2>
              </div>
            </header>

            <section class="astrael-character-settings-group" aria-label="{{localize 'ASTRAEL.Settings.Interface'}}">
              <header>
                <i class="fas fa-display" aria-hidden="true"></i>
                <h3>{{localize "ASTRAEL.Settings.Interface"}}</h3>
              </header>
              <div class="astrael-character-setting-row">
                <span class="astrael-character-setting-icon" aria-hidden="true"><i class="fas fa-circle-info"></i></span>
                <span class="astrael-character-setting-copy">
                  <strong>{{localize "ASTRAEL.Settings.ResourceTooltips"}}</strong>
                  <small>{{localize "ASTRAEL.Settings.ResourceTooltipsHint"}}</small>
                </span>
                <button
                  type="button"
                  class="astrael-character-setting-toggle {{#if characterResourceTooltipsEnabled}}is-active{{/if}}"
                  data-action="set-character-resource-tooltips"
                  data-disabled="{{#if characterResourceTooltipsEnabled}}true{{else}}false{{/if}}"
                  role="switch"
                  aria-checked="{{#if characterResourceTooltipsEnabled}}true{{else}}false{{/if}}"
                  aria-label="{{localize 'ASTRAEL.Settings.ResourceTooltips'}}"
                >
                  <span aria-hidden="true"></span>
                  <strong>{{#if characterResourceTooltipsEnabled}}{{localize "ASTRAEL.Settings.Enabled"}}{{else}}{{localize "ASTRAEL.Settings.Disabled"}}{{/if}}</strong>
                </button>
              </div>
            </section>
          </section>
        </div>
      </section>
      {{#if characterResourceTooltipAvailable}}
      <aside class="astrael-character-resource-tooltip" role="tooltip">
        <strong>{{localize "ASTRAEL.CharacterHeader.Controls"}}</strong>
        <span><kbd>{{localize "ASTRAEL.CharacterHeader.LeftClick"}}</kbd>{{localize "ASTRAEL.CharacterHeader.RecoverDamage"}}</span>
        <span><kbd>{{localize "ASTRAEL.CharacterHeader.RightClick"}}</kbd>{{localize "ASTRAEL.CharacterHeader.SuperficialDamage"}}</span>
        <span><kbd>Shift + {{localize "ASTRAEL.CharacterHeader.RightClick"}}</kbd>{{localize "ASTRAEL.CharacterHeader.AggravatedDamage"}}</span>
        <button type="button" data-action="set-character-resource-tooltips" data-disabled="true"><i class="fas fa-eye-slash" aria-hidden="true"></i>{{localize "ASTRAEL.CharacterHeader.DisableControlHints"}}</button>
      </aside>
      {{/if}}
    </section>
    {{/if}}
  </main>
</form>
