<form class="{{cssClass}} astrael-character-sheet {{#if characterPortraitViewer}}is-portrait-viewer{{/if}}" autocomplete="off">
  <main class="astrael-character-shell">
    {{#if characterPortraitViewer}}
    <section class="astrael-character-portrait-viewer" aria-label="{{localize 'ASTRAEL.CharacterPortrait.FullImage'}}">
      <div class="astrael-character-portrait-viewer-stage">
        <button type="button" class="astrael-character-portrait-viewer-back" data-action="close-character-portrait-viewer">
          <i class="fas fa-arrow-left" aria-hidden="true"></i>
          <span>{{localize "ASTRAEL.CharacterPortrait.BackToSheet"}}</span>
        </button>
        <img src="{{characterPortrait.src}}" alt="{{actor.name}}">
      </div>
    </section>
    {{else}}
    <section class="astrael-character-frame">
      <header class="astrael-character-header">
        <div class="astrael-character-header-expanded">
          <div class="astrael-character-portrait-wrap">
            <button class="astrael-character-portrait" type="button" data-action="edit-character-portrait" title="{{localize 'ASTRAEL.CharacterHeader.ChangePortrait'}}" aria-label="{{localize 'ASTRAEL.CharacterHeader.ChangePortrait'}}" {{#unless characterCanEditPortrait}}disabled{{/unless}}>
              <img src="{{actor.img}}" alt="{{actor.name}}" style="object-position: {{characterPortrait.x}}% {{characterPortrait.y}}%; transform: scale({{characterPortrait.zoom}}) translate({{characterPortrait.panX}}%, {{characterPortrait.panY}}%);">
            </button>
            <button class="astrael-character-portrait-view" type="button" data-action="view-character-portrait" title="{{localize 'ASTRAEL.CharacterPortrait.ViewFull'}}" aria-label="{{localize 'ASTRAEL.CharacterPortrait.ViewFull'}}">
              <i class="fas fa-expand" aria-hidden="true"></i>
            </button>
          </div>

          <div class="astrael-character-header-details">
            <label class="astrael-character-name-field">
              <span>{{localize "ASTRAEL.CharacterHeader.Name"}}</span>
              <input name="name" type="text" value="{{actor.name}}">
            </label>

            <section class="astrael-character-resource health-card" data-resource="health">
              <div class="astrael-character-resource-title">
                <span><i class="fas fa-heart-pulse" aria-hidden="true"></i>{{localize "ASTRAEL.Resource.Health"}}{{#if characterResourceTooltipAvailable}}<i class="fas fa-circle-info astrael-character-resource-hint" aria-hidden="true"></i>{{/if}}</span>
                <strong>{{system.resources.health.active}}<small>/{{system.resources.health.max}}</small></strong>
              </div>
              <div class="astrael-character-box-track" aria-label="{{localize 'ASTRAEL.Resource.Health'}}">
                {{#each system.resources.health.boxes as |box|}}
                <button class="resource-box astrael-character-resource-box {{box.state}}" type="button" data-resource="health" data-index="{{box.index}}" data-state="{{box.state}}" title="{{localize 'ASTRAEL.CharacterHeader.ResourceHint'}}"></button>
                {{/each}}
              </div>
            </section>

            <section class="astrael-character-resource will-card" data-resource="willpower">
              <div class="astrael-character-resource-title">
                <span><i class="fas fa-shield-halved" aria-hidden="true"></i>{{localize "ASTRAEL.Resource.Willpower"}}{{#if characterResourceTooltipAvailable}}<i class="fas fa-circle-info astrael-character-resource-hint" aria-hidden="true"></i>{{/if}}</span>
                <strong>{{system.resources.willpower.active}}<small>/{{system.resources.willpower.max}}</small></strong>
              </div>
              <div class="astrael-character-box-track" aria-label="{{localize 'ASTRAEL.Resource.Willpower'}}">
                {{#each system.resources.willpower.boxes as |box|}}
                <button class="resource-box astrael-character-resource-box {{box.state}}" type="button" data-resource="willpower" data-index="{{box.index}}" data-state="{{box.state}}" title="{{localize 'ASTRAEL.CharacterHeader.ResourceHint'}}"></button>
                {{/each}}
              </div>
            </section>
          </div>
        </div>
      </header>

      <nav class="sheet-tabs astrael-character-tabs" aria-label="{{localize 'ASTRAEL.Sheet.Character'}}">
        <div class="sheet-tab-list astrael-character-tab-list">
          <button class="tab-button astrael-character-tab active" data-tab="attributes" type="button" title="{{localize 'ASTRAEL.Tab.Attributes'}}" aria-label="{{localize 'ASTRAEL.Tab.Attributes'}}">
            <i class="fas fa-chart-simple" aria-hidden="true"></i>
          </button>
          <button class="tab-button astrael-character-tab" data-tab="advantages" type="button" title="{{localize 'ASTRAEL.Tab.Advantages'}}" aria-label="{{localize 'ASTRAEL.Tab.Advantages'}}">
            <i class="fas fa-compass" aria-hidden="true"></i>
          </button>
          <button class="tab-button astrael-character-tab" data-tab="convictions" type="button" title="{{localize 'ASTRAEL.Tab.Convictions'}}" aria-label="{{localize 'ASTRAEL.Tab.Convictions'}}">
            <i class="fas fa-scale-balanced" aria-hidden="true"></i>
          </button>
          {{#if system.sheetSettings.visibleTabs.virtues}}
          <button class="tab-button astrael-character-tab" data-tab="virtues" type="button" title="{{localize 'ASTRAEL.Tab.Virtues'}}" aria-label="{{localize 'ASTRAEL.Tab.Virtues'}}">
            <i class="fas fa-sun" aria-hidden="true"></i>
          </button>
          {{/if}}
          {{#if system.sheetSettings.visibleTabs.hemomancy}}
          <button class="tab-button astrael-character-tab" data-tab="hemomancy" type="button" title="{{localize 'ASTRAEL.Tab.Hemomancy'}}" aria-label="{{localize 'ASTRAEL.Tab.Hemomancy'}}">
            <i class="fas fa-droplet" aria-hidden="true"></i>
          </button>
          {{/if}}
          {{#if system.sheetSettings.visibleTabs.strangerMark}}
          <button class="tab-button astrael-character-tab" data-tab="stranger-mark" type="button" title="{{localize 'ASTRAEL.Tab.StrangerMark'}}" aria-label="{{localize 'ASTRAEL.Tab.StrangerMark'}}">
            <i class="fas fa-eye" aria-hidden="true"></i>
          </button>
          {{/if}}
          <button class="tab-button astrael-character-tab" data-tab="ascension" type="button" title="{{localize 'ASTRAEL.Tab.Ascension'}}" aria-label="{{localize 'ASTRAEL.Tab.Ascension'}}">
            <i class="fas fa-arrow-trend-up" aria-hidden="true"></i>
          </button>
          <button class="tab-button astrael-character-tab" data-tab="settings" type="button" title="{{localize 'ASTRAEL.Tab.Settings'}}" aria-label="{{localize 'ASTRAEL.Tab.Settings'}}">
            <i class="fas fa-gear" aria-hidden="true"></i>
          </button>
        </div>
      </nav>

      <section class="sheet-body astrael-character-body">
        <div class="tab-panel astrael-character-panel active" data-tab="attributes">
          {{#if characterSkillRemoval}}
          <section class="astrael-character-removal-confirmation" role="alertdialog" aria-modal="true" aria-label="{{localize 'ASTRAEL.CharacterSkills.RemoveConfirmTitle'}}">
            <span class="astrael-character-removal-confirmation-icon" aria-hidden="true"><i class="fas fa-trash"></i></span>
            <h2 class="astrael-character-removal-confirmation-title">{{localize "ASTRAEL.CharacterSkills.RemoveConfirmTitle"}}</h2>
            <strong class="astrael-character-removal-confirmation-skill">{{characterSkillRemoval.label}}</strong>
            <p class="astrael-character-removal-confirmation-hint">{{localize "ASTRAEL.CharacterSkills.RemoveConfirmHint"}}</p>
            <div class="astrael-character-removal-confirmation-actions">
              <button type="button" data-action="cancel-skill-removal">{{localize "ASTRAEL.CharacterSkills.Cancel"}}</button>
              <button type="button" class="is-danger" data-action="confirm-skill-removal">{{localize "ASTRAEL.CharacterSkills.Remove"}}</button>
            </div>
          </section>
          {{else if characterSpecialtyRemoval}}
          <section class="astrael-character-removal-confirmation" role="alertdialog" aria-modal="true" aria-label="{{localize 'ASTRAEL.CharacterSpecialties.RemoveConfirmTitle'}}">
            <span class="astrael-character-removal-confirmation-icon" aria-hidden="true"><i class="fas fa-trash"></i></span>
            <h2 class="astrael-character-removal-confirmation-title">{{localize "ASTRAEL.CharacterSpecialties.RemoveConfirmTitle"}}</h2>
            <strong class="astrael-character-removal-confirmation-skill">{{characterSpecialtyRemoval.name}}</strong>
            <p class="astrael-character-removal-confirmation-hint">{{localize "ASTRAEL.CharacterSpecialties.RemoveConfirmHint"}}</p>
            <div class="astrael-character-removal-confirmation-actions">
              <button type="button" data-action="cancel-specialty-removal">{{localize "ASTRAEL.CharacterSkills.Cancel"}}</button>
              <button type="button" class="is-danger" data-action="confirm-specialty-removal">{{localize "ASTRAEL.CharacterSkills.Remove"}}</button>
            </div>
          </section>
          {{else if characterSpecialtiesView}}
          <section class="astrael-character-specialties-view" role="dialog" aria-modal="true" aria-label="{{localize 'ASTRAEL.CharacterSpecialties.Title'}}: {{characterSpecialtiesView.label}}">
            <header class="astrael-character-specialties-view-header">
              <div class="astrael-character-specialties-view-heading">
                <span>{{localize "ASTRAEL.CharacterSpecialties.Title"}}</span>
                <strong>{{characterSpecialtiesView.label}}</strong>
              </div>
              <div class="astrael-character-specialties-view-tools">
                <span class="astrael-character-specialty-count" aria-label="{{localize 'ASTRAEL.CharacterSpecialties.Count'}}: {{characterSpecialtiesView.specialties.length}}">{{characterSpecialtiesView.specialties.length}}</span>
                <button type="button" data-action="close-character-specialties" title="{{localize 'ASTRAEL.CharacterSpecialties.Close'}}" aria-label="{{localize 'ASTRAEL.CharacterSpecialties.Close'}}"><i class="fas fa-xmark" aria-hidden="true"></i></button>
              </div>
            </header>

            <div class="astrael-character-specialty-list">
              {{#each characterSpecialtiesView.specialties as |specialty|}}
              <div class="astrael-character-specialty-item">
                <span class="astrael-character-specialty-marker" aria-hidden="true"></span>
                <span class="astrael-character-specialty-name">{{#if specialty.name}}{{specialty.name}}{{else}}{{localize "ASTRAEL.CharacterSpecialties.Unnamed"}}{{/if}}</span>
                {{#if ../characterSpecialtiesView.canManage}}
                <button type="button" data-action="remove-character-specialty" data-index="{{specialty.index}}" title="{{localize 'ASTRAEL.CharacterSpecialties.Remove'}}" aria-label="{{localize 'ASTRAEL.CharacterSpecialties.Remove'}}: {{specialty.name}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                {{/if}}
              </div>
              {{/each}}
              {{#unless characterSpecialtiesView.specialties.length}}
              <p class="astrael-character-specialties-empty">{{localize "ASTRAEL.CharacterSpecialties.Empty"}}</p>
              {{/unless}}
            </div>

            {{#if characterSpecialtiesView.canManage}}
              {{#if characterSpecialtiesView.adding}}
              <div class="astrael-character-specialty-composer">
                <label>
                  <span>{{localize "ASTRAEL.CharacterSpecialties.Name"}}</span>
                  <input type="text" data-action="character-specialty-name" maxlength="120" placeholder="{{localize 'ASTRAEL.CharacterSpecialties.NamePlaceholder'}}">
                </label>
                <div>
                  <button type="button" data-action="cancel-character-specialty">{{localize "ASTRAEL.CharacterSkills.Cancel"}}</button>
                  <button type="button" class="is-primary" data-action="save-character-specialty">{{localize "ASTRAEL.CharacterSkills.Save"}}</button>
                </div>
              </div>
              {{else}}
              <footer class="astrael-character-specialties-view-footer">
                <span>{{localize "ASTRAEL.CharacterSpecialties.ManageHint"}}</span>
                <button type="button" class="astrael-character-specialty-add" data-action="begin-character-specialty" data-key="{{characterSpecialtiesView.key}}"><i class="fas fa-plus" aria-hidden="true"></i>{{localize "ASTRAEL.CharacterSpecialties.Add"}}</button>
              </footer>
              {{/if}}
            {{/if}}
          </section>
          {{else if characterSkillPicker}}
          <section class="astrael-character-skill-picker" role="dialog" aria-modal="true" aria-label="{{localize 'ASTRAEL.CharacterSkills.PickerTitle'}}">
            <header class="astrael-character-skill-picker-header">
              <div class="astrael-character-skill-picker-heading">
                <span>{{localize "ASTRAEL.CharacterSkills.PickerTitle"}}</span>
                <strong>{{characterSkillPicker.total}} {{localize "ASTRAEL.CharacterSkills.Available"}}</strong>
              </div>
              <div class="astrael-character-skill-picker-tools">
                <span class="astrael-character-specialty-count" aria-label="{{localize 'ASTRAEL.CharacterSkills.Count'}}: {{characterSkillPicker.selectedCount}}">{{characterSkillPicker.selectedCount}}</span>
                <button type="button" data-action="close-character-skill-picker" title="{{localize 'ASTRAEL.CharacterSpecialties.Close'}}" aria-label="{{localize 'ASTRAEL.CharacterSpecialties.Close'}}"><i class="fas fa-xmark" aria-hidden="true"></i></button>
              </div>
            </header>

            <div class="astrael-character-skill-picker-search">
              <i class="fas fa-magnifying-glass" aria-hidden="true"></i>
              <input type="search" data-action="search-character-skill-picker" value="{{characterSkillPicker.query}}" placeholder="{{localize 'ASTRAEL.CharacterSkills.SearchPlaceholder'}}" aria-label="{{localize 'ASTRAEL.CharacterSkills.SearchPlaceholder'}}">
            </div>

            <div class="astrael-character-skill-picker-list">
              {{#each characterSkillPicker.rows as |row|}}
              <article class="astrael-character-skill-picker-row {{#if row.selected}}is-selected{{/if}}" data-key="{{row.key}}">
                <span class="astrael-character-skill-name">{{row.label}}</span>
                <div class="astrael-character-skill-level" aria-label="{{row.label}}, {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{row.level}}">
                  {{#each row.levels as |level|}}
                  <button type="button" class="{{#if level.filled}}is-filled{{/if}} {{#if level.current}}is-current{{/if}}" data-action="set-character-skill-picker-level" data-key="{{../key}}" data-level="{{level.value}}" aria-label="{{localize 'ASTRAEL.CharacterAttributes.Level'}} {{level.value}}: {{../label}}"></button>
                  {{/each}}
                </div>
              </article>
              {{/each}}
              {{#unless characterSkillPicker.rows.length}}
              <p class="astrael-character-skill-picker-empty">{{localize "ASTRAEL.CharacterSkills.SearchEmpty"}}</p>
              {{/unless}}
            </div>

            <footer class="astrael-character-skill-picker-footer">
              <span>{{localize "ASTRAEL.CharacterSkills.PickerHint"}}</span>
              <div>
                <button type="button" data-action="cancel-character-skill-picker">{{localize "ASTRAEL.CharacterSkills.Cancel"}}</button>
                <button type="button" class="is-primary" data-action="save-character-skill-picker" {{#unless characterSkillPicker.selectedCount}}disabled{{/unless}}>{{localize "ASTRAEL.CharacterSkills.Save"}}</button>
              </div>
            </footer>
          </section>
          {{else}}
          <section class="astrael-character-status-strip" aria-label="{{localize 'ASTRAEL.CharacterStatus.Title'}}">
            <div class="astrael-character-status is-initiative" role="group" title="{{localize 'ASTRAEL.CharacterStatus.Initiative'}}: {{characterStatus.initiative}}" aria-label="{{localize 'ASTRAEL.CharacterStatus.Initiative'}}: {{characterStatus.initiative}}">
              <span class="astrael-character-status-icon" aria-hidden="true"><i class="fas fa-bolt"></i></span>
              <span class="astrael-character-status-label" aria-hidden="true">{{localize "ASTRAEL.CharacterStatus.Initiative"}}</span>
              <strong>{{characterStatus.initiative}}</strong>
            </div>
            <div class="astrael-character-status is-armor" role="group" title="{{localize 'ASTRAEL.CharacterStatus.Armor'}}: {{characterStatus.armor}}" aria-label="{{localize 'ASTRAEL.CharacterStatus.Armor'}}: {{characterStatus.armor}}">
              <span class="astrael-character-status-icon" aria-hidden="true"><i class="fas fa-shield-halved"></i></span>
              <span class="astrael-character-status-label" aria-hidden="true">{{localize "ASTRAEL.CharacterStatus.Armor"}}</span>
              <strong>{{characterStatus.armor}}</strong>
            </div>
            <div class="astrael-character-status is-movement" role="group" title="{{localize 'ASTRAEL.CharacterStatus.MovementValue' value=characterStatus.movement}}" aria-label="{{localize 'ASTRAEL.CharacterStatus.MovementValue' value=characterStatus.movement}}">
              <span class="astrael-character-status-icon" aria-hidden="true"><i class="fas fa-shoe-prints"></i></span>
              <span class="astrael-character-status-label" aria-hidden="true">{{localize "ASTRAEL.CharacterStatus.Movement"}}</span>
              <strong>{{characterStatus.movement}}</strong>
            </div>
          </section>

          <section class="astrael-character-attributes {{#if characterAttributesCollapsed}}is-collapsed{{/if}}">
            <header class="astrael-character-attribute-region-title">
              <div>
                <span aria-hidden="true"></span>
                <h2 class="astrael-character-section-title">{{localize "ASTRAEL.CharacterAttributes.Title"}}</h2>
              </div>
              <button type="button" class="astrael-character-attributes-toggle" data-action="toggle-character-attributes" title="{{#if characterAttributesCollapsed}}{{localize 'ASTRAEL.CharacterAttributes.Expand'}}{{else}}{{localize 'ASTRAEL.CharacterAttributes.Collapse'}}{{/if}}" aria-label="{{#if characterAttributesCollapsed}}{{localize 'ASTRAEL.CharacterAttributes.Expand'}}{{else}}{{localize 'ASTRAEL.CharacterAttributes.Collapse'}}{{/if}}" aria-expanded="{{#if characterAttributesCollapsed}}false{{else}}true{{/if}}">
                <i class="fas {{#if characterAttributesCollapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}" aria-hidden="true"></i>
              </button>
            </header>

            <section class="astrael-character-attribute-band is-physical" aria-label="{{localize 'ASTRAEL.Attributes.Physical'}}">
              <article class="astrael-character-attribute">
                <button class="astrael-character-attribute-dial level-{{system.attributes.strength.value}}" type="button" data-action="adjust-character-attribute" data-key="strength" data-name="system.attributes.strength.value" data-value="{{system.attributes.strength.value}}" title="{{localize 'ASTRAEL.Attribute.Strength'}} · {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.strength.value}} · {{localize 'ASTRAEL.CharacterAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Strength'}}, {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.strength.value}}">
                  <span class="astrael-character-dial-segment segment-1"></span><span class="astrael-character-dial-segment segment-2"></span><span class="astrael-character-dial-segment segment-3"></span><span class="astrael-character-dial-segment segment-4"></span><span class="astrael-character-dial-segment segment-5"></span>
                  <i class="fas fa-hand-fist" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-character-attribute-roll" href="#" data-type="attribute" data-key="strength" title="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Strength'}}" aria-label="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Strength'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-character-attribute">
                <button class="astrael-character-attribute-dial level-{{system.attributes.dexterity.value}}" type="button" data-action="adjust-character-attribute" data-key="dexterity" data-name="system.attributes.dexterity.value" data-value="{{system.attributes.dexterity.value}}" title="{{localize 'ASTRAEL.Attribute.Dexterity'}} · {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.dexterity.value}} · {{localize 'ASTRAEL.CharacterAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Dexterity'}}, {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.dexterity.value}}">
                  <span class="astrael-character-dial-segment segment-1"></span><span class="astrael-character-dial-segment segment-2"></span><span class="astrael-character-dial-segment segment-3"></span><span class="astrael-character-dial-segment segment-4"></span><span class="astrael-character-dial-segment segment-5"></span>
                  <i class="fas fa-person-running" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-character-attribute-roll" href="#" data-type="attribute" data-key="dexterity" title="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Dexterity'}}" aria-label="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Dexterity'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-character-attribute">
                <button class="astrael-character-attribute-dial level-{{system.attributes.stamina.value}}" type="button" data-action="adjust-character-attribute" data-key="stamina" data-name="system.attributes.stamina.value" data-value="{{system.attributes.stamina.value}}" title="{{localize 'ASTRAEL.Attribute.Stamina'}} · {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.stamina.value}} · {{localize 'ASTRAEL.CharacterAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Stamina'}}, {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.stamina.value}}">
                  <span class="astrael-character-dial-segment segment-1"></span><span class="astrael-character-dial-segment segment-2"></span><span class="astrael-character-dial-segment segment-3"></span><span class="astrael-character-dial-segment segment-4"></span><span class="astrael-character-dial-segment segment-5"></span>
                  <i class="fas fa-heart" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-character-attribute-roll" href="#" data-type="attribute" data-key="stamina" title="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Stamina'}}" aria-label="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Stamina'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
            </section>

            <section class="astrael-character-attribute-band is-social" aria-label="{{localize 'ASTRAEL.Attributes.Social'}}">
              <article class="astrael-character-attribute">
                <button class="astrael-character-attribute-dial level-{{system.attributes.charisma.value}}" type="button" data-action="adjust-character-attribute" data-key="charisma" data-name="system.attributes.charisma.value" data-value="{{system.attributes.charisma.value}}" title="{{localize 'ASTRAEL.Attribute.Charisma'}} · {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.charisma.value}} · {{localize 'ASTRAEL.CharacterAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Charisma'}}, {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.charisma.value}}">
                  <span class="astrael-character-dial-segment segment-1"></span><span class="astrael-character-dial-segment segment-2"></span><span class="astrael-character-dial-segment segment-3"></span><span class="astrael-character-dial-segment segment-4"></span><span class="astrael-character-dial-segment segment-5"></span>
                  <i class="fas fa-comments" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-character-attribute-roll" href="#" data-type="attribute" data-key="charisma" title="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Charisma'}}" aria-label="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Charisma'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-character-attribute">
                <button class="astrael-character-attribute-dial level-{{system.attributes.manipulation.value}}" type="button" data-action="adjust-character-attribute" data-key="manipulation" data-name="system.attributes.manipulation.value" data-value="{{system.attributes.manipulation.value}}" title="{{localize 'ASTRAEL.Attribute.Manipulation'}} · {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.manipulation.value}} · {{localize 'ASTRAEL.CharacterAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Manipulation'}}, {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.manipulation.value}}">
                  <span class="astrael-character-dial-segment segment-1"></span><span class="astrael-character-dial-segment segment-2"></span><span class="astrael-character-dial-segment segment-3"></span><span class="astrael-character-dial-segment segment-4"></span><span class="astrael-character-dial-segment segment-5"></span>
                  <i class="fas fa-masks-theater" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-character-attribute-roll" href="#" data-type="attribute" data-key="manipulation" title="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Manipulation'}}" aria-label="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Manipulation'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-character-attribute">
                <button class="astrael-character-attribute-dial level-{{system.attributes.composure.value}}" type="button" data-action="adjust-character-attribute" data-key="composure" data-name="system.attributes.composure.value" data-value="{{system.attributes.composure.value}}" title="{{localize 'ASTRAEL.Attribute.Composure'}} · {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.composure.value}} · {{localize 'ASTRAEL.CharacterAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Composure'}}, {{localize 'ASTRAEL.CharacterAttributes.Level'}} {{system.attributes.composure.value}}">
