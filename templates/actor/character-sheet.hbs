                <div class="astrael-conviction-inspector-belief"><i class="fas fa-feather-pointed" aria-hidden="true"></i><span><small>{{localize "ASTRAEL.Convictions.Name"}}</small><strong>{{characterConvictionDock.nameLabel}}</strong><p>{{characterConvictionDock.descriptionLabel}}</p></span></div>
                <div class="astrael-conviction-inspector-fractures"><span>{{localize "ASTRAEL.Convictions.Fractures"}}</span><strong>{{characterConvictionDock.fractures}}/2</strong></div>
              </div>
              <footer class="astrael-conviction-actions"><button type="button" data-action="cancel-conviction">{{localize "ASTRAEL.CharacterCharacteristics.Close"}}</button></footer>
              {{/if}}
            </section>
