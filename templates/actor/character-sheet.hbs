                  <label><span>{{localize "ASTRAEL.Convictions.PillarDescription"}}</span><textarea maxlength="1200" data-conviction-field="pillar-description" placeholder="{{localize 'ASTRAEL.Convictions.PillarDescriptionPlaceholder'}}">{{characterConvictionDock.pillar.description}}</textarea></label>
