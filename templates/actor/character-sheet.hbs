              </label>
              <label>
                <span>{{localize "ASTRAEL.CharacterCharacteristics.Description"}}</span>
                <textarea data-action="characteristic-description" maxlength="1000" placeholder="{{localize 'ASTRAEL.CharacterCharacteristics.DescriptionPlaceholder'}}">{{characterCharacteristicEditor.description}}</textarea>
              </label>
