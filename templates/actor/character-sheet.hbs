                  <span class="astrael-character-dial-segment segment-1"></span><span class="astrael-character-dial-segment segment-2"></span><span class="astrael-character-dial-segment segment-3"></span><span class="astrael-character-dial-segment segment-4"></span><span class="astrael-character-dial-segment segment-5"></span>
                  <i class="fas fa-brain" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-character-attribute-roll" href="#" data-type="attribute" data-key="intelligence" title="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Intelligence'}}" aria-label="{{localize 'ASTRAEL.CharacterAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Intelligence'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
