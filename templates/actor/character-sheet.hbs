            <strong class="astrael-character-removal-confirmation-skill">{{characterCharacteristicRemoval.name}}</strong>
            <p class="astrael-character-removal-confirmation-hint">{{localize "ASTRAEL.CharacterCharacteristics.RemoveHint"}}</p>
