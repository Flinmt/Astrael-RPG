                <strong>{{characterCharacteristicEditor.typeLabel}}</strong>
              </div>
            </header>
            <div class="astrael-character-characteristic-editor-form">
              <label>
                <span>{{localize "ASTRAEL.CharacterCharacteristics.Name"}}</span>
