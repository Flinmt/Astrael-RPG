<form class="{{cssClass}} astrael-rpg sheet actor npc-sheet" autocomplete="off">
  {{#if npcCreator.active}}
  <main class="npc-creator">
    <section class="npc-creator-hero">
      <div class="npc-creator-portrait-wrap">
        <button class="portrait-ring npc-creator-portrait" type="button" data-action="editImage" title="Alterar retrato">
          <img class="profile-img" src="{{actor.img}}" alt="{{actor.name}}">
        </button>
      </div>

      <div class="npc-creator-identity">
        <span>Criacao de NPC</span>
        <label>
          <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do NPC">
        </label>
        <p>Escolha uma presenca narrativa, gere uma distribuicao e ajuste a ficha depois se quiser.</p>
      </div>

      <div class="npc-creator-actions">
        <button type="button" class="npc-creator-command secondary" data-action="blank-npc">Ficha em Branco</button>
        <button type="button" class="npc-creator-command" data-action="generate-npc">Gerar NPC</button>
      </div>
    </section>

    <section class="npc-creator-grid">
      <div class="npc-creator-column">
        <div class="npc-creator-panel npc-importance-panel">
          <header>
            <span>Escala</span>
            <h2>Importancia</h2>
          </header>
          <div class="npc-importance-control">
            <button type="button" class="npc-importance-arrow" data-action="decrease-npc-importance" data-direction="down" {{#unless npcCreator.importance.canDecrease}}disabled{{/unless}} aria-label="Diminuir importancia">
              <i class="fas fa-chevron-left"></i>
            </button>
            <div class="npc-importance-current" tabindex="0" aria-describedby="npc-importance-tooltip">
              <strong>{{npcCreator.importance.label}}</strong>
              <span id="npc-importance-tooltip" class="npc-importance-tooltip">{{npcCreator.importance.description}}</span>
            </div>
            <button type="button" class="npc-importance-arrow" data-action="increase-npc-importance" data-direction="up" {{#unless npcCreator.importance.canIncrease}}disabled{{/unless}} aria-label="Aumentar importancia">
              <i class="fas fa-chevron-right"></i>
            </button>
          </div>
        </div>

        <div class="npc-creator-panel npc-skill-distribution-panel">
          <header>
            <span>Distribuicao</span>
            <h2>Pericias</h2>
          </header>
          <div class="npc-distribution-options">
            {{#each npcCreator.skillDistributions as |distribution|}}
            <button type="button" class="npc-distribution-card {{#if distribution.selected}}is-selected{{/if}}" data-action="select-npc-skill-distribution" data-distribution="{{distribution.id}}">
              <span class="npc-choice-title">{{distribution.label}}</span>
              <span class="npc-choice-description">{{distribution.description}}</span>
            </button>
            {{/each}}
          </div>
        </div>
      </div>

      <div class="npc-creator-panel npc-creator-archetypes">
        <header>
          <span>Funcao dramatica</span>
          <h2>Arquetipo</h2>
        </header>
        <div class="npc-creator-options">
          {{#each npcCreator.archetypes as |archetype|}}
          <button type="button" class="npc-choice-card {{#if archetype.selected}}is-selected{{/if}}" data-action="select-npc-archetype" data-archetype="{{archetype.id}}">
            <span class="npc-choice-title">{{archetype.label}}</span>
            <span class="npc-choice-description">{{archetype.description}}</span>
          </button>
          {{/each}}
        </div>
      </div>

      <div class="npc-preview-column">
        <aside class="npc-creator-preview">
          <header>
            <span>Dados do personagem</span>
          </header>

          <div class="npc-preview-resources">
            <div>
              <span>Vida</span>
              <strong>{{npcCreator.draft.health}}</strong>
            </div>
            <div>
              <span>Vontade</span>
              <strong>{{npcCreator.draft.willpower}}</strong>
            </div>
          </div>

          {{#if npcCreator.draft.optionalTabLabel}}
          <div class="npc-preview-extra-tab">
            <div>
              <span>Aba Extra</span>
              <strong>{{npcCreator.draft.optionalTabLabel}}</strong>
            </div>
          </div>
          {{/if}}

          <section class="npc-preview-list">
            <h3>Atributos</h3>
            {{#each npcCreator.draft.attributePreview as |trait|}}
            <div><span>{{trait.label}}</span><strong>{{trait.value}}</strong></div>
            {{/each}}
          </section>

          <section class="npc-preview-list">
            <h3>Pericias</h3>
            {{#each npcCreator.draft.skillPreview as |trait|}}
            <div><span>{{trait.label}}</span><strong>{{trait.value}}</strong></div>
            {{/each}}
          </section>

        </aside>

        <button type="button" class="npc-creator-command full" data-action="reroll-npc-draft">Redistribuir Pontos</button>
      </div>
    </section>
  </main>
  {{else}}
  <main class="sheet-shell">
    <section class="sheet-frame">
      <header class="sheet-header npc-header">
        <div class="npc-identity-grid">
          <div class="portrait-cell npc-portrait-cell" aria-label="Retrato do NPC">
            <button class="portrait-ring npc-portrait" type="button" data-action="editImage" title="Alterar retrato">
              <img class="profile-img" src="{{actor.img}}" alt="{{actor.name}}">
            </button>
          </div>

          <div class="npc-left-stack">
            <section class="field-card npc-archetype-card">
              <span>Arquetipo</span>
              <strong>{{npcArchetypeLabel}}</strong>
            </section>
            <div class="resource-row npc-health-row">
              <div class="damage-controls" aria-label="{{localize 'ASTRAEL.Resource.Health'}}">
                <button class="damage-card superficial-damage" type="button" data-damage="superficial" data-resource="health" title="Dano superficial">/</button>
                <button class="damage-card aggravated-damage" type="button" data-damage="aggravated" data-resource="health" title="Dano agravado">X</button>
              </div>
              <section class="resource-card health-card" data-resource="health">
                <div class="resource-title">
                  <span>{{localize "ASTRAEL.Resource.Health"}}</span>
                  <strong class="resource-active-roman">{{system.resources.health.activeRoman}}</strong>
                </div>
                <div class="box-track" aria-label="{{localize 'ASTRAEL.Resource.Health'}}">
                  {{#each system.resources.health.boxes as |box|}}
                  <button class="resource-box {{box.state}}" type="button" data-resource="health" data-index="{{box.index}}" data-state="{{box.state}}" title="Clique para alterar"></button>
                  {{/each}}
                </div>
              </section>
            </div>
            <section class="marker-card marker-card--sangria npc-sangria-card">
              <div class="marker-title">
                <span>{{localize "ASTRAEL.Sangria"}}</span>
                <div class="marker-controls">
                  <button type="button" class="marker-btn" data-action="adjust-resource" data-resource="sangria" data-delta="-1">-</button>
                  <button type="button" class="marker-btn" data-action="adjust-resource" data-resource="sangria" data-delta="1">+</button>
                </div>
              </div>
              <div class="dot-track dot-track--sangria dots-{{system.sangria.value}}" data-name="system.sangria.value" data-value="{{system.sangria.value}}">
                <span class="sv-track-label">{{system.sangria.value}}/5</span>
              </div>
            </section>
          </div>

          <div class="npc-right-stack">
            <label class="field-card npc-name">
              <span>Nome</span>
              <input name="name" type="text" value="{{actor.name}}" placeholder="Nome do NPC">
            </label>
            <div class="resource-row npc-will-row">
              <section class="resource-card will-card" data-resource="willpower">
                <div class="resource-title">
                  <span>{{localize "ASTRAEL.Resource.Willpower"}}</span>
                  <strong class="resource-active-roman">{{system.resources.willpower.activeRoman}}</strong>
                </div>
                <div class="box-track" aria-label="{{localize 'ASTRAEL.Resource.Willpower'}}">
                  {{#each system.resources.willpower.boxes as |box|}}
                  <button class="resource-box {{box.state}}" type="button" data-resource="willpower" data-index="{{box.index}}" data-state="{{box.state}}" title="Clique para alterar"></button>
                  {{/each}}
                </div>
              </section>
              <div class="damage-controls" aria-label="{{localize 'ASTRAEL.Resource.Willpower'}}">
                <button class="damage-card superficial-damage" type="button" data-damage="superficial" data-resource="willpower" title="Dano superficial">/</button>
                <button class="damage-card aggravated-damage" type="button" data-damage="aggravated" data-resource="willpower" title="Dano agravado">X</button>
              </div>
            </div>
            <section class="marker-card marker-card--vazio npc-vazio-card">
              <div class="marker-title">
                <span>{{localize "ASTRAEL.Vazio"}}</span>
                <div class="marker-controls">
                  <button type="button" class="marker-btn" data-action="adjust-resource" data-resource="vazio" data-delta="-1">-</button>
                  <button type="button" class="marker-btn" data-action="adjust-resource" data-resource="vazio" data-delta="1">+</button>
                </div>
              </div>
              <div class="dot-track dot-track--vazio dots-{{system.vazio.value}}" data-name="system.vazio.value" data-value="{{system.vazio.value}}">
                <span class="sv-track-label">{{system.vazio.value}}/5</span>
              </div>
            </section>
          </div>
        </div>
      </header>

      <nav class="sheet-tabs" aria-label="Abas da ficha">
        <button class="tab-button active" data-tab="attributes" type="button">{{localize "ASTRAEL.Tab.Attributes"}}</button>
        <button class="tab-button" data-tab="advantages" type="button">{{localize "ASTRAEL.Tab.Advantages"}}</button>
        {{#if system.sheetSettings.visibleTabs.virtues}}
        <button class="tab-button" data-tab="virtues" type="button">{{localize "ASTRAEL.Tab.Virtues"}}</button>
        {{/if}}
        {{#if system.sheetSettings.visibleTabs.hemomancy}}
        <button class="tab-button" data-tab="hemomancy" type="button">{{localize "ASTRAEL.Tab.Hemomancy"}}</button>
        {{/if}}
        {{#if system.sheetSettings.visibleTabs.strangerMark}}
        <button class="tab-button" data-tab="stranger-mark" type="button">{{localize "ASTRAEL.Tab.StrangerMark"}}</button>
        {{/if}}
        <button class="settings-gear" data-tab="settings" type="button" title="{{localize 'ASTRAEL.Tab.Settings'}}">
          <i class="fas fa-cog"></i>
        </button>
      </nav>

      <section class="sheet-body">
        <div class="tab-panel active" data-tab="attributes">
          <section class="section-card">
            <div class="section-title">
              <h2>{{localize "ASTRAEL.Tab.Attributes"}}</h2>
            </div>
            <div class="three-columns">
              <article class="trait-group physical">
                <h3>{{localize "ASTRAEL.Attributes.Physical"}}</h3>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="strength">{{localize "ASTRAEL.Attribute.Strength"}}</span>
                  <div class="dot-track dots-{{system.attributes.strength.value}}" data-name="system.attributes.strength.value" data-value="{{system.attributes.strength.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="dexterity">{{localize "ASTRAEL.Attribute.Dexterity"}}</span>
                  <div class="dot-track dots-{{system.attributes.dexterity.value}}" data-name="system.attributes.dexterity.value" data-value="{{system.attributes.dexterity.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="stamina">{{localize "ASTRAEL.Attribute.Stamina"}}</span>
                  <div class="dot-track dots-{{system.attributes.stamina.value}}" data-name="system.attributes.stamina.value" data-value="{{system.attributes.stamina.value}}"></div>
                </div>
              </article>

              <article class="trait-group social">
                <h3>{{localize "ASTRAEL.Attributes.Social"}}</h3>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="charisma">{{localize "ASTRAEL.Attribute.Charisma"}}</span>
                  <div class="dot-track dots-{{system.attributes.charisma.value}}" data-name="system.attributes.charisma.value" data-value="{{system.attributes.charisma.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="manipulation">{{localize "ASTRAEL.Attribute.Manipulation"}}</span>
                  <div class="dot-track dots-{{system.attributes.manipulation.value}}" data-name="system.attributes.manipulation.value" data-value="{{system.attributes.manipulation.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="composure">{{localize "ASTRAEL.Attribute.Composure"}}</span>
                  <div class="dot-track dots-{{system.attributes.composure.value}}" data-name="system.attributes.composure.value" data-value="{{system.attributes.composure.value}}"></div>
                </div>
              </article>

              <article class="trait-group mental">
                <h3>{{localize "ASTRAEL.Attributes.Mental"}}</h3>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="intelligence">{{localize "ASTRAEL.Attribute.Intelligence"}}</span>
                  <div class="dot-track dots-{{system.attributes.intelligence.value}}" data-name="system.attributes.intelligence.value" data-value="{{system.attributes.intelligence.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="wits">{{localize "ASTRAEL.Attribute.Wits"}}</span>
                  <div class="dot-track dots-{{system.attributes.wits.value}}" data-name="system.attributes.wits.value" data-value="{{system.attributes.wits.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="attribute" data-key="resolve">{{localize "ASTRAEL.Attribute.Resolve"}}</span>
                  <div class="dot-track dots-{{system.attributes.resolve.value}}" data-name="system.attributes.resolve.value" data-value="{{system.attributes.resolve.value}}"></div>
                </div>
              </article>
            </div>
          </section>

          <section class="section-card skills-card">
            <div class="section-title">
              <h2>{{localize "ASTRAEL.Skills.Title"}}</h2>
              <button type="button" class="specialty-open" data-action="open-specialties" title="Especialidades" aria-label="Especialidades">
                <span class="specialty-open-icon" aria-hidden="true"></span>
              </button>
            </div>
            <div class="three-columns skill-columns">
              <article class="trait-group physical">
                <h3>{{localize "ASTRAEL.Skills.Physical"}}</h3>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="athletics">{{localize "ASTRAEL.Skill.Athletics"}}</span>
                  <div class="dot-track dots-{{system.skills.athletics.value}}" data-name="system.skills.athletics.value" data-value="{{system.skills.athletics.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="brawl">{{localize "ASTRAEL.Skill.Brawl"}}</span>
                  <div class="dot-track dots-{{system.skills.brawl.value}}" data-name="system.skills.brawl.value" data-value="{{system.skills.brawl.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="drive">{{localize "ASTRAEL.Skill.Drive"}}</span>
                  <div class="dot-track dots-{{system.skills.drive.value}}" data-name="system.skills.drive.value" data-value="{{system.skills.drive.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="stealth">{{localize "ASTRAEL.Skill.Stealth"}}</span>
                  <div class="dot-track dots-{{system.skills.stealth.value}}" data-name="system.skills.stealth.value" data-value="{{system.skills.stealth.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="larceny">{{localize "ASTRAEL.Skill.Larceny"}}</span>
                  <div class="dot-track dots-{{system.skills.larceny.value}}" data-name="system.skills.larceny.value" data-value="{{system.skills.larceny.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="crafts">{{localize "ASTRAEL.Skill.Crafts"}}</span>
                  <div class="dot-track dots-{{system.skills.crafts.value}}" data-name="system.skills.crafts.value" data-value="{{system.skills.crafts.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="firearms">{{localize "ASTRAEL.Skill.Firearms"}}</span>
                  <div class="dot-track dots-{{system.skills.firearms.value}}" data-name="system.skills.firearms.value" data-value="{{system.skills.firearms.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="melee">{{localize "ASTRAEL.Skill.Melee"}}</span>
                  <div class="dot-track dots-{{system.skills.melee.value}}" data-name="system.skills.melee.value" data-value="{{system.skills.melee.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="survival">{{localize "ASTRAEL.Skill.Survival"}}</span>
                  <div class="dot-track dots-{{system.skills.survival.value}}" data-name="system.skills.survival.value" data-value="{{system.skills.survival.value}}"></div>
                </div>
              </article>

              <article class="trait-group social">
                <h3>{{localize "ASTRAEL.Skills.Social"}}</h3>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="animalKen">{{localize "ASTRAEL.Skill.AnimalKen"}}</span>
                  <div class="dot-track dots-{{system.skills.animalKen.value}}" data-name="system.skills.animalKen.value" data-value="{{system.skills.animalKen.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="empathy">{{localize "ASTRAEL.Skill.Empathy"}}</span>
                  <div class="dot-track dots-{{system.skills.empathy.value}}" data-name="system.skills.empathy.value" data-value="{{system.skills.empathy.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="etiquette">{{localize "ASTRAEL.Skill.Etiquette"}}</span>
                  <div class="dot-track dots-{{system.skills.etiquette.value}}" data-name="system.skills.etiquette.value" data-value="{{system.skills.etiquette.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="expression">{{localize "ASTRAEL.Skill.Expression"}}</span>
                  <div class="dot-track dots-{{system.skills.expression.value}}" data-name="system.skills.expression.value" data-value="{{system.skills.expression.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="intimidation">{{localize "ASTRAEL.Skill.Intimidation"}}</span>
                  <div class="dot-track dots-{{system.skills.intimidation.value}}" data-name="system.skills.intimidation.value" data-value="{{system.skills.intimidation.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="leadership">{{localize "ASTRAEL.Skill.Leadership"}}</span>
                  <div class="dot-track dots-{{system.skills.leadership.value}}" data-name="system.skills.leadership.value" data-value="{{system.skills.leadership.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="persuasion">{{localize "ASTRAEL.Skill.Persuasion"}}</span>
                  <div class="dot-track dots-{{system.skills.persuasion.value}}" data-name="system.skills.persuasion.value" data-value="{{system.skills.persuasion.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="streetwise">{{localize "ASTRAEL.Skill.Streetwise"}}</span>
                  <div class="dot-track dots-{{system.skills.streetwise.value}}" data-name="system.skills.streetwise.value" data-value="{{system.skills.streetwise.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="subterfuge">{{localize "ASTRAEL.Skill.Subterfuge"}}</span>
                  <div class="dot-track dots-{{system.skills.subterfuge.value}}" data-name="system.skills.subterfuge.value" data-value="{{system.skills.subterfuge.value}}"></div>
                </div>
              </article>

              <article class="trait-group mental">
                <h3>{{localize "ASTRAEL.Skills.Mental"}}</h3>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="academics">{{localize "ASTRAEL.Skill.Academics"}}</span>
                  <div class="dot-track dots-{{system.skills.academics.value}}" data-name="system.skills.academics.value" data-value="{{system.skills.academics.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="awareness">{{localize "ASTRAEL.Skill.Awareness"}}</span>
                  <div class="dot-track dots-{{system.skills.awareness.value}}" data-name="system.skills.awareness.value" data-value="{{system.skills.awareness.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="finance">{{localize "ASTRAEL.Skill.Finance"}}</span>
                  <div class="dot-track dots-{{system.skills.finance.value}}" data-name="system.skills.finance.value" data-value="{{system.skills.finance.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="investigation">{{localize "ASTRAEL.Skill.Investigation"}}</span>
                  <div class="dot-track dots-{{system.skills.investigation.value}}" data-name="system.skills.investigation.value" data-value="{{system.skills.investigation.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="medicine">{{localize "ASTRAEL.Skill.Medicine"}}</span>
                  <div class="dot-track dots-{{system.skills.medicine.value}}" data-name="system.skills.medicine.value" data-value="{{system.skills.medicine.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="occult">{{localize "ASTRAEL.Skill.Occult"}}</span>
                  <div class="dot-track dots-{{system.skills.occult.value}}" data-name="system.skills.occult.value" data-value="{{system.skills.occult.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="politics">{{localize "ASTRAEL.Skill.Politics"}}</span>
                  <div class="dot-track dots-{{system.skills.politics.value}}" data-name="system.skills.politics.value" data-value="{{system.skills.politics.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="science">{{localize "ASTRAEL.Skill.Science"}}</span>
                  <div class="dot-track dots-{{system.skills.science.value}}" data-name="system.skills.science.value" data-value="{{system.skills.science.value}}"></div>
                </div>
                <div class="trait-row">
                  <span class="rollable" data-type="skill" data-key="technology">{{localize "ASTRAEL.Skill.Technology"}}</span>
                  <div class="dot-track dots-{{system.skills.technology.value}}" data-name="system.skills.technology.value" data-value="{{system.skills.technology.value}}"></div>
