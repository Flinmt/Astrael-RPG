<form class="{{cssClass}} astrael-compact-sheet" autocomplete="off">
  <main class="astrael-compact-shell">
    <section class="astrael-compact-frame">
      <header class="astrael-compact-character-header">
        <div class="astrael-compact-header-expanded">
          <div class="astrael-compact-portrait-wrap">
            <button class="astrael-compact-portrait" type="button" data-action="edit-compact-portrait" title="{{localize 'ASTRAEL.CompactHeader.ChangePortrait'}}" aria-label="{{localize 'ASTRAEL.CompactHeader.ChangePortrait'}}" {{#unless compactCanEditPortrait}}disabled{{/unless}}>
              <img src="{{actor.img}}" alt="{{actor.name}}" style="object-position: {{compactPortrait.x}}% {{compactPortrait.y}}%; transform: scale({{compactPortrait.zoom}}) translate({{compactPortrait.panX}}%, {{compactPortrait.panY}}%);">
            </button>
            <button class="astrael-compact-portrait-view" type="button" data-action="view-compact-portrait" title="{{localize 'ASTRAEL.CompactPortrait.ViewFull'}}" aria-label="{{localize 'ASTRAEL.CompactPortrait.ViewFull'}}">
              <i class="fas fa-expand" aria-hidden="true"></i>
            </button>
          </div>

          <div class="astrael-compact-header-details">
            <label class="astrael-compact-name-field">
              <span>{{localize "ASTRAEL.CompactHeader.Name"}}</span>
              <input name="name" type="text" value="{{actor.name}}">
            </label>

            <section class="astrael-compact-resource health-card" data-resource="health">
              <div class="astrael-compact-resource-title">
                <span><i class="fas fa-heart-pulse" aria-hidden="true"></i>{{localize "ASTRAEL.Resource.Health"}}{{#if compactResourceTooltipsDisabled}}<button type="button" class="astrael-compact-resource-hint" data-action="set-compact-resource-tooltips" data-disabled="false" title="{{localize 'ASTRAEL.CompactHeader.EnableControlHints'}}" aria-label="{{localize 'ASTRAEL.CompactHeader.EnableControlHints'}}"><i class="fas fa-circle-info" aria-hidden="true"></i></button>{{else}}{{#if compactResourceTooltipAvailable}}<i class="fas fa-circle-info astrael-compact-resource-hint" aria-hidden="true"></i>{{/if}}{{/if}}</span>
                <strong>{{system.resources.health.active}}<small>/{{system.resources.health.max}}</small></strong>
              </div>
              <div class="astrael-compact-box-track" aria-label="{{localize 'ASTRAEL.Resource.Health'}}">
                {{#each system.resources.health.boxes as |box|}}
                <button class="resource-box astrael-compact-resource-box {{box.state}}" type="button" data-resource="health" data-index="{{box.index}}" data-state="{{box.state}}" title="{{localize 'ASTRAEL.CompactHeader.ResourceHint'}}"></button>
                {{/each}}
              </div>
            </section>

            <section class="astrael-compact-resource will-card" data-resource="willpower">
              <div class="astrael-compact-resource-title">
                <span><i class="fas fa-shield-halved" aria-hidden="true"></i>{{localize "ASTRAEL.Resource.Willpower"}}{{#if compactResourceTooltipsDisabled}}<button type="button" class="astrael-compact-resource-hint" data-action="set-compact-resource-tooltips" data-disabled="false" title="{{localize 'ASTRAEL.CompactHeader.EnableControlHints'}}" aria-label="{{localize 'ASTRAEL.CompactHeader.EnableControlHints'}}"><i class="fas fa-circle-info" aria-hidden="true"></i></button>{{else}}{{#if compactResourceTooltipAvailable}}<i class="fas fa-circle-info astrael-compact-resource-hint" aria-hidden="true"></i>{{/if}}{{/if}}</span>
                <strong>{{system.resources.willpower.active}}<small>/{{system.resources.willpower.max}}</small></strong>
              </div>
              <div class="astrael-compact-box-track" aria-label="{{localize 'ASTRAEL.Resource.Willpower'}}">
                {{#each system.resources.willpower.boxes as |box|}}
                <button class="resource-box astrael-compact-resource-box {{box.state}}" type="button" data-resource="willpower" data-index="{{box.index}}" data-state="{{box.state}}" title="{{localize 'ASTRAEL.CompactHeader.ResourceHint'}}"></button>
                {{/each}}
              </div>
            </section>
          </div>
        </div>
      </header>

      <nav class="sheet-tabs astrael-compact-tabs" aria-label="{{localize 'ASTRAEL.Sheet.CharacterCompact'}}">
        <div class="sheet-tab-list astrael-compact-tab-list">
          <button class="tab-button astrael-compact-tab active" data-tab="attributes" type="button" title="{{localize 'ASTRAEL.Tab.Attributes'}}" aria-label="{{localize 'ASTRAEL.Tab.Attributes'}}">
            <i class="fas fa-chart-simple" aria-hidden="true"></i>
          </button>
          <button class="tab-button astrael-compact-tab" data-tab="advantages" type="button" title="{{localize 'ASTRAEL.Tab.Advantages'}}" aria-label="{{localize 'ASTRAEL.Tab.Advantages'}}">
            <i class="fas fa-scale-balanced" aria-hidden="true"></i>
          </button>
          <button class="tab-button astrael-compact-tab" data-tab="convictions" type="button" title="{{localize 'ASTRAEL.Tab.Convictions'}}" aria-label="{{localize 'ASTRAEL.Tab.Convictions'}}">
            <i class="fas fa-compass" aria-hidden="true"></i>
          </button>
          {{#if system.sheetSettings.visibleTabs.virtues}}
          <button class="tab-button astrael-compact-tab" data-tab="virtues" type="button" title="{{localize 'ASTRAEL.Tab.Virtues'}}" aria-label="{{localize 'ASTRAEL.Tab.Virtues'}}">
            <i class="fas fa-sun" aria-hidden="true"></i>
          </button>
          {{/if}}
          {{#if system.sheetSettings.visibleTabs.hemomancy}}
          <button class="tab-button astrael-compact-tab" data-tab="hemomancy" type="button" title="{{localize 'ASTRAEL.Tab.Hemomancy'}}" aria-label="{{localize 'ASTRAEL.Tab.Hemomancy'}}">
            <i class="fas fa-droplet" aria-hidden="true"></i>
          </button>
          {{/if}}
          {{#if system.sheetSettings.visibleTabs.strangerMark}}
          <button class="tab-button astrael-compact-tab" data-tab="stranger-mark" type="button" title="{{localize 'ASTRAEL.Tab.StrangerMark'}}" aria-label="{{localize 'ASTRAEL.Tab.StrangerMark'}}">
            <i class="fas fa-eye" aria-hidden="true"></i>
          </button>
          {{/if}}
          <button class="tab-button astrael-compact-tab" data-tab="settings" type="button" title="{{localize 'ASTRAEL.Tab.Settings'}}" aria-label="{{localize 'ASTRAEL.Tab.Settings'}}">
            <i class="fas fa-gear" aria-hidden="true"></i>
          </button>
        </div>
      </nav>

      <section class="sheet-body astrael-compact-body">
        <div class="tab-panel astrael-compact-panel active" data-tab="attributes">
          <section class="astrael-compact-attributes {{#if compactAttributesCollapsed}}is-collapsed{{/if}}">
            <header class="astrael-compact-attribute-region-title">
              <span aria-hidden="true"></span>
              <h3>{{localize "ASTRAEL.Tab.Attributes"}}</h3>
              <button type="button" class="astrael-compact-attributes-toggle" data-action="toggle-compact-attributes" title="{{#if compactAttributesCollapsed}}{{localize 'ASTRAEL.CompactAttributes.Expand'}}{{else}}{{localize 'ASTRAEL.CompactAttributes.Collapse'}}{{/if}}" aria-label="{{#if compactAttributesCollapsed}}{{localize 'ASTRAEL.CompactAttributes.Expand'}}{{else}}{{localize 'ASTRAEL.CompactAttributes.Collapse'}}{{/if}}" aria-expanded="{{#if compactAttributesCollapsed}}false{{else}}true{{/if}}">
                <i class="fas {{#if compactAttributesCollapsed}}fa-chevron-down{{else}}fa-chevron-up{{/if}}" aria-hidden="true"></i>
              </button>
            </header>

            <section class="astrael-compact-attribute-band is-physical" aria-label="{{localize 'ASTRAEL.Attributes.Physical'}}">
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.strength.value}}" type="button" data-action="adjust-compact-attribute" data-key="strength" data-name="system.attributes.strength.value" data-value="{{system.attributes.strength.value}}" title="{{localize 'ASTRAEL.Attribute.Strength'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.strength.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Strength'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.strength.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-hand-fist" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="strength" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Strength'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Strength'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.dexterity.value}}" type="button" data-action="adjust-compact-attribute" data-key="dexterity" data-name="system.attributes.dexterity.value" data-value="{{system.attributes.dexterity.value}}" title="{{localize 'ASTRAEL.Attribute.Dexterity'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.dexterity.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Dexterity'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.dexterity.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-person-running" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="dexterity" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Dexterity'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Dexterity'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.stamina.value}}" type="button" data-action="adjust-compact-attribute" data-key="stamina" data-name="system.attributes.stamina.value" data-value="{{system.attributes.stamina.value}}" title="{{localize 'ASTRAEL.Attribute.Stamina'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.stamina.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Stamina'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.stamina.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-heart" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="stamina" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Stamina'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Stamina'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
            </section>

            <section class="astrael-compact-attribute-band is-social" aria-label="{{localize 'ASTRAEL.Attributes.Social'}}">
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.charisma.value}}" type="button" data-action="adjust-compact-attribute" data-key="charisma" data-name="system.attributes.charisma.value" data-value="{{system.attributes.charisma.value}}" title="{{localize 'ASTRAEL.Attribute.Charisma'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.charisma.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Charisma'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.charisma.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-comments" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="charisma" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Charisma'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Charisma'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.manipulation.value}}" type="button" data-action="adjust-compact-attribute" data-key="manipulation" data-name="system.attributes.manipulation.value" data-value="{{system.attributes.manipulation.value}}" title="{{localize 'ASTRAEL.Attribute.Manipulation'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.manipulation.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Manipulation'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.manipulation.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-masks-theater" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="manipulation" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Manipulation'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Manipulation'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.composure.value}}" type="button" data-action="adjust-compact-attribute" data-key="composure" data-name="system.attributes.composure.value" data-value="{{system.attributes.composure.value}}" title="{{localize 'ASTRAEL.Attribute.Composure'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.composure.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Composure'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.composure.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-face-meh" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="composure" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Composure'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Composure'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
            </section>

            <section class="astrael-compact-attribute-band is-mental" aria-label="{{localize 'ASTRAEL.Attributes.Mental'}}">
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.intelligence.value}}" type="button" data-action="adjust-compact-attribute" data-key="intelligence" data-name="system.attributes.intelligence.value" data-value="{{system.attributes.intelligence.value}}" title="{{localize 'ASTRAEL.Attribute.Intelligence'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.intelligence.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Intelligence'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.intelligence.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-brain" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="intelligence" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Intelligence'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Intelligence'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.wits.value}}" type="button" data-action="adjust-compact-attribute" data-key="wits" data-name="system.attributes.wits.value" data-value="{{system.attributes.wits.value}}" title="{{localize 'ASTRAEL.Attribute.Wits'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.wits.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Wits'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.wits.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-bolt" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="wits" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Wits'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Wits'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
              <article class="astrael-compact-attribute">
                <button class="astrael-compact-attribute-dial level-{{system.attributes.resolve.value}}" type="button" data-action="adjust-compact-attribute" data-key="resolve" data-name="system.attributes.resolve.value" data-value="{{system.attributes.resolve.value}}" title="{{localize 'ASTRAEL.Attribute.Resolve'}} · {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.resolve.value}} · {{localize 'ASTRAEL.CompactAttributes.AdjustHint'}}" aria-label="{{localize 'ASTRAEL.Attribute.Resolve'}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{system.attributes.resolve.value}}">
                  <span class="astrael-compact-dial-segment segment-1"></span><span class="astrael-compact-dial-segment segment-2"></span><span class="astrael-compact-dial-segment segment-3"></span><span class="astrael-compact-dial-segment segment-4"></span><span class="astrael-compact-dial-segment segment-5"></span>
                  <i class="fas fa-anchor" aria-hidden="true"></i>
                </button>
                <a class="rollable astrael-compact-attribute-roll" href="#" data-type="attribute" data-key="resolve" title="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Resolve'}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Roll'}}: {{localize 'ASTRAEL.Attribute.Resolve'}}"><i class="fas fa-dice" aria-hidden="true"></i></a>
              </article>
            </section>
          </section>

          <section class="astrael-compact-skills">
            <header class="astrael-compact-skills-header">
              <div class="astrael-compact-skills-title">
                <span aria-hidden="true"></span>
                <h3>{{localize "ASTRAEL.Skills.Title"}}</h3>
              </div>
              {{#if compactCanAddSkill}}
              <button type="button" class="astrael-compact-skills-configure" data-action="add-compact-skill">{{localize "ASTRAEL.CompactSkills.Add"}}</button>
              {{else}}
              <button type="button" class="astrael-compact-skills-configure" disabled>{{localize "ASTRAEL.CompactSkills.Add"}}</button>
              {{/if}}
            </header>

            <div class="astrael-compact-skill-list">
              {{#each compactActiveSkills as |skill|}}
              <article class="astrael-compact-skill-row {{#if skill.selected}}is-selected{{/if}}">
                <a class="rollable astrael-compact-skill-name" href="#" data-type="skill" data-key="{{skill.key}}" title="{{localize 'ASTRAEL.CompactSkills.Roll'}}: {{skill.label}}">
                  {{skill.label}}
                </a>
                <div class="astrael-compact-skill-level" aria-label="{{skill.label}}, {{localize 'ASTRAEL.CompactAttributes.Level'}} {{skill.value}}">
                  {{#each skill.levels as |level|}}
                  <span class="{{#if level.filled}}is-filled{{/if}}"></span>
                  {{/each}}
                </div>
                <button type="button" class="astrael-compact-skill-specialties {{#if skill.specialtiesOpen}}is-active{{/if}}" data-action="toggle-compact-specialties" data-key="{{skill.key}}" title="{{localize 'ASTRAEL.CompactSpecialties.Open'}}: {{skill.label}}" aria-label="{{localize 'ASTRAEL.CompactSpecialties.Open'}}: {{skill.label}}" aria-expanded="{{#if skill.specialtiesOpen}}true{{else}}false{{/if}}" {{#unless skill.canOpenSpecialties}}disabled{{/unless}}>
                  <i class="fas fa-tags" aria-hidden="true"></i>
                  {{#if skill.specialtyCount}}<span>{{skill.specialtyCount}}</span>{{/if}}
                </button>
                {{#if skill.canEdit}}
                <button type="button" class="astrael-compact-skill-edit" data-action="edit-compact-skill" data-key="{{skill.key}}" title="{{localize 'ASTRAEL.CompactSkills.Edit'}}" aria-label="{{localize 'ASTRAEL.CompactSkills.Edit'}}: {{skill.label}}"><i class="fas fa-pen" aria-hidden="true"></i></button>
                {{else}}
                <button type="button" class="astrael-compact-skill-edit" disabled aria-label="{{localize 'ASTRAEL.CompactSkills.Edit'}}: {{skill.label}}"><i class="fas fa-pen" aria-hidden="true"></i></button>
                {{/if}}

                {{#if skill.specialtiesOpen}}
                <section class="astrael-compact-specialties" aria-label="{{localize 'ASTRAEL.CompactSpecialties.Title'}}: {{skill.label}}">
                  <header>
                    <span>{{localize "ASTRAEL.CompactSpecialties.Title"}}</span>
                    <strong>{{skill.label}}</strong>
                  </header>

                  <div class="astrael-compact-specialty-list">
                    {{#each skill.specialties as |specialty|}}
                    <div class="astrael-compact-specialty-item">
                      <span>{{#if specialty.name}}{{specialty.name}}{{else}}{{localize "ASTRAEL.CompactSpecialties.Unnamed"}}{{/if}}</span>
                      {{#if ../canManageSpecialties}}
                      <button type="button" data-action="remove-compact-specialty" data-index="{{specialty.index}}" title="{{localize 'ASTRAEL.CompactSpecialties.Remove'}}" aria-label="{{localize 'ASTRAEL.CompactSpecialties.Remove'}}: {{specialty.name}}"><i class="fas fa-trash" aria-hidden="true"></i></button>
                      {{/if}}
                    </div>
                    {{/each}}
                    {{#unless skill.specialties.length}}
                    <p class="astrael-compact-specialties-empty">{{localize "ASTRAEL.CompactSpecialties.Empty"}}</p>
                    {{/unless}}
                  </div>

                  {{#if skill.canManageSpecialties}}
                    {{#if skill.addingSpecialty}}
                    <div class="astrael-compact-specialty-entry">
                      <input type="text" data-action="compact-specialty-name" maxlength="120" placeholder="{{localize 'ASTRAEL.CompactSpecialties.NamePlaceholder'}}" aria-label="{{localize 'ASTRAEL.CompactSpecialties.Name'}}">
                      <button type="button" data-action="cancel-compact-specialty" title="{{localize 'ASTRAEL.CompactSkills.Cancel'}}" aria-label="{{localize 'ASTRAEL.CompactSkills.Cancel'}}"><i class="fas fa-xmark" aria-hidden="true"></i></button>
                      <button type="button" class="is-primary" data-action="save-compact-specialty" title="{{localize 'ASTRAEL.CompactSkills.Save'}}" aria-label="{{localize 'ASTRAEL.CompactSkills.Save'}}"><i class="fas fa-check" aria-hidden="true"></i></button>
                    </div>
                    {{else}}
                    <button type="button" class="astrael-compact-specialty-add" data-action="begin-compact-specialty" data-key="{{skill.key}}"><i class="fas fa-plus" aria-hidden="true"></i>{{localize "ASTRAEL.CompactSpecialties.Add"}}</button>
                    {{/if}}
                  {{/if}}
                </section>
                {{/if}}
              </article>
              {{/each}}
              {{#unless compactActiveSkills.length}}
              <div class="astrael-compact-skills-empty">
                <span>{{localize "ASTRAEL.CompactSkills.Empty"}}</span>
              </div>
              {{/unless}}
            </div>

            {{#if compactSkillEditor}}
            <section class="astrael-compact-skill-dock {{#if compactSkillEditor.confirmingRemoval}}is-confirming{{/if}}">
              {{#if compactSkillEditor.confirmingRemoval}}
              <div class="astrael-compact-skill-remove-confirmation">
                <strong>{{localize "ASTRAEL.CompactSkills.RemoveConfirmTitle"}}</strong>
                <span>{{localize "ASTRAEL.CompactSkills.RemoveConfirmHint"}}</span>
              </div>
              <div class="astrael-compact-skill-dock-actions">
                <button type="button" data-action="back-remove-compact-skill">{{localize "ASTRAEL.CompactSkills.Back"}}</button>
                <button type="button" class="is-danger" data-action="confirm-remove-compact-skill">{{localize "ASTRAEL.CompactSkills.Remove"}}</button>
              </div>
              {{else}}
              <div class="astrael-compact-skill-dock-fields">
                {{#if compactSkillEditor.adding}}
                <label class="astrael-compact-skill-dock-select">
                  <span>{{localize "ASTRAEL.CompactSkills.Skill"}}</span>
                  <select data-action="select-compact-editor-skill">
                    <option value="">{{localize "ASTRAEL.CompactSkills.Select"}}</option>
                    {{#each compactSkillEditor.options as |option|}}
                    <option value="{{option.key}}" {{#if option.selected}}selected{{/if}}>{{option.label}}</option>
                    {{/each}}
                  </select>
                </label>
                {{else}}
                <div class="astrael-compact-skill-dock-name">
                  <span>{{localize "ASTRAEL.CompactSkills.Edit"}}</span>
                  <strong>{{compactSkillEditor.label}}</strong>
                </div>
                {{/if}}

                <div class="astrael-compact-skill-dock-level">
                  <span>{{localize "ASTRAEL.CompactAttributes.Level"}} {{compactSkillEditor.level}}</span>
                  <div>
                    {{#each compactSkillEditor.levels as |level|}}
                    <button type="button" class="{{#if level.filled}}is-filled{{/if}} {{#if level.current}}is-current{{/if}}" data-action="set-compact-editor-level" data-level="{{level.value}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Level'}} {{level.value}}"></button>
                    {{/each}}
                  </div>
                </div>
              </div>
              <div class="astrael-compact-skill-dock-actions">
                {{#if compactSkillEditor.editing}}
                <button type="button" class="is-danger is-remove" data-action="request-remove-compact-skill">{{localize "ASTRAEL.CompactSkills.Remove"}}</button>
                {{/if}}
                <button type="button" data-action="cancel-compact-skill-editor">{{localize "ASTRAEL.CompactSkills.Cancel"}}</button>
                <button type="button" class="is-primary" data-action="save-compact-skill-editor">{{localize "ASTRAEL.CompactSkills.Save"}}</button>
              </div>
              {{/if}}
            </section>
            {{/if}}
          </section>
        </div>
        <div class="tab-panel astrael-compact-panel" data-tab="advantages">
          <section class="astrael-compact-characteristics {{#if compactCharacteristics.isFlaw}}is-flaws{{else}}is-advantages{{/if}}">
            <header class="astrael-compact-characteristics-header">
              <div>
                <span aria-hidden="true"></span>
                <h2>{{localize "ASTRAEL.Tab.Advantages"}}</h2>
              </div>
              {{#if compactCharacteristics.canAdd}}
              <button type="button" class="astrael-compact-characteristic-add" data-action="add-compact-characteristic"><i class="fas fa-plus" aria-hidden="true"></i>{{#if compactCharacteristics.isFlaw}}{{localize "ASTRAEL.CompactCharacteristics.AddFlaw"}}{{else}}{{localize "ASTRAEL.CompactCharacteristics.AddAdvantage"}}{{/if}}</button>
              {{else}}
              <button type="button" class="astrael-compact-characteristic-add" disabled><i class="fas fa-plus" aria-hidden="true"></i>{{#if compactCharacteristics.isFlaw}}{{localize "ASTRAEL.CompactCharacteristics.AddFlaw"}}{{else}}{{localize "ASTRAEL.CompactCharacteristics.AddAdvantage"}}{{/if}}</button>
              {{/if}}
            </header>

            <nav class="astrael-compact-characteristic-modes" aria-label="{{localize 'ASTRAEL.Tab.Advantages'}}">
              <button type="button" class="is-advantage {{#if compactCharacteristics.advantagesActive}}is-active{{/if}}" data-action="set-compact-characteristic-mode" data-list="advantages" {{#if compactCharacteristics.locked}}disabled{{/if}}>
                <span>{{localize "ASTRAEL.CompactCharacteristics.Advantages"}}</span><strong>{{compactCharacteristics.advantagesCount}}</strong>
              </button>
              <button type="button" class="is-flaw {{#if compactCharacteristics.flawsActive}}is-active{{/if}}" data-action="set-compact-characteristic-mode" data-list="flaws" {{#if compactCharacteristics.locked}}disabled{{/if}}>
                <span>{{localize "ASTRAEL.CompactCharacteristics.Flaws"}}</span><strong>{{compactCharacteristics.flawsCount}}</strong>
              </button>
            </nav>

            <div class="astrael-compact-characteristic-list">
              {{#each compactCharacteristics.activeList as |entry|}}
              <button type="button" class="astrael-compact-characteristic-card {{#if entry.selected}}is-selected{{/if}}" data-action="select-compact-characteristic" data-list="{{entry.listId}}" data-index="{{entry.index}}" {{#if ../compactCharacteristics.locked}}disabled{{/if}}>
                <span class="astrael-compact-characteristic-name">{{entry.name}}</span>
                <span class="astrael-compact-characteristic-level" aria-label="{{localize 'ASTRAEL.CompactAttributes.Level'}} {{entry.level}}">
                  {{#each entry.levels as |level|}}<i class="{{#if level.filled}}is-filled{{/if}}"></i>{{/each}}
                </span>
                <i class="fas fa-chevron-right astrael-compact-characteristic-open" aria-hidden="true"></i>
              </button>
              {{/each}}
              {{#if compactCharacteristics.empty}}
              <div class="astrael-compact-characteristics-empty">
                <span>{{#if compactCharacteristics.isFlaw}}{{localize "ASTRAEL.CompactCharacteristics.EmptyFlaws"}}{{else}}{{localize "ASTRAEL.CompactCharacteristics.EmptyAdvantages"}}{{/if}}</span>
              </div>
              {{/if}}
            </div>

            {{#if compactCharacteristicDock}}
            <section class="astrael-compact-characteristic-dock {{#if compactCharacteristicDock.isFlaw}}is-flaw{{else}}is-advantage{{/if}}">
              {{#if compactCharacteristicDock.isRemove}}
              <div class="astrael-compact-characteristic-remove">
                <strong>{{localize "ASTRAEL.CompactCharacteristics.RemoveTitle"}}</strong>
                <span>{{compactCharacteristicDock.name}}</span>
              </div>
              <div class="astrael-compact-characteristic-actions">
                <button type="button" data-action="back-remove-compact-characteristic">{{localize "ASTRAEL.CompactSkills.Back"}}</button>
                <button type="button" class="is-danger" data-action="confirm-remove-compact-characteristic">{{localize "ASTRAEL.CompactSkills.Remove"}}</button>
              </div>
              {{else}}
                {{#if compactCharacteristicDock.isEdit}}
                <div class="astrael-compact-characteristic-form">
                  <label>
                    <span>{{localize "ASTRAEL.CompactCharacteristics.Name"}}</span>
                    <input type="text" data-action="compact-characteristic-name" maxlength="120" value="{{compactCharacteristicDock.name}}" placeholder="{{localize 'ASTRAEL.CompactCharacteristics.NamePlaceholder'}}">
                  </label>
                  <label>
                    <span>{{localize "ASTRAEL.CompactCharacteristics.Description"}}</span>
                    <textarea data-action="compact-characteristic-description" maxlength="1000" placeholder="{{localize 'ASTRAEL.CompactCharacteristics.DescriptionPlaceholder'}}">{{compactCharacteristicDock.description}}</textarea>
                  </label>
                  <div class="astrael-compact-characteristic-level-editor">
                    <span>{{localize "ASTRAEL.CompactAttributes.Level"}} {{compactCharacteristicDock.level}}</span>
                    <div>
                      {{#each compactCharacteristicDock.levels as |level|}}
                      <button type="button" class="{{#if level.filled}}is-filled{{/if}} {{#if level.current}}is-current{{/if}}" data-action="set-compact-characteristic-level" data-level="{{level.value}}" aria-label="{{localize 'ASTRAEL.CompactAttributes.Level'}} {{level.value}}"></button>
                      {{/each}}
                    </div>
                  </div>
                </div>
                <div class="astrael-compact-characteristic-actions">
                  <button type="button" data-action="close-compact-characteristic">{{localize "ASTRAEL.CompactSkills.Cancel"}}</button>
                  <button type="button" class="is-primary" data-action="save-compact-characteristic">{{localize "ASTRAEL.CompactSkills.Save"}}</button>
                </div>
                {{else}}
                <header class="astrael-compact-characteristic-inspector-head">
                  <span>{{compactCharacteristicDock.typeLabel}}</span>
                  <strong>{{compactCharacteristicDock.name}}</strong>
                  <em>{{localize "ASTRAEL.CompactAttributes.Level"}} {{compactCharacteristicDock.level}}</em>
                </header>
                <p class="astrael-compact-characteristic-description">{{#if compactCharacteristicDock.description}}{{compactCharacteristicDock.description}}{{else}}{{localize "ASTRAEL.CompactCharacteristics.NoDescription"}}{{/if}}</p>
                <div class="astrael-compact-characteristic-actions">
                  {{#if compactCharacteristicDock.canRoll}}
                  <button type="button" class="rollable is-roll" data-type="advantage" data-key="{{compactCharacteristicDock.index}}"><i class="fas fa-dice" aria-hidden="true"></i>{{localize "ASTRAEL.CompactSkills.Roll"}}</button>
                  {{/if}}
                  <button type="button" data-action="close-compact-characteristic">{{localize "ASTRAEL.CompactCharacteristics.Close"}}</button>
                  {{#if compactCharacteristicDock.canManage}}
                  <button type="button" data-action="edit-compact-characteristic"><i class="fas fa-pen" aria-hidden="true"></i>{{localize "ASTRAEL.CompactSkills.Edit"}}</button>
                  <button type="button" class="is-danger" data-action="request-remove-compact-characteristic">{{localize "ASTRAEL.CompactSkills.Remove"}}</button>
                  {{/if}}
                </div>
                {{/if}}
              {{/if}}
            </section>
            {{/if}}
          </section>
        </div>
        <div class="tab-panel astrael-compact-panel" data-tab="convictions">
          <h2>{{localize "ASTRAEL.Tab.Convictions"}}</h2>
        </div>
        <div class="tab-panel astrael-compact-panel" data-tab="virtues">
          <h2>{{localize "ASTRAEL.Tab.Virtues"}}</h2>
        </div>
        <div class="tab-panel astrael-compact-panel" data-tab="hemomancy">
          <h2>{{localize "ASTRAEL.Tab.Hemomancy"}}</h2>
        </div>
        <div class="tab-panel astrael-compact-panel" data-tab="stranger-mark">
          <h2>{{localize "ASTRAEL.Tab.StrangerMark"}}</h2>
        </div>
        <div class="tab-panel astrael-compact-panel" data-tab="settings">
          <h2>{{localize "ASTRAEL.Tab.Settings"}}</h2>
        </div>
      </section>
      {{#if compactResourceTooltipAvailable}}
      <aside class="astrael-compact-resource-tooltip" role="tooltip">
        <strong>{{localize "ASTRAEL.CompactHeader.Controls"}}</strong>
        <span><kbd>{{localize "ASTRAEL.CompactHeader.LeftClick"}}</kbd>{{localize "ASTRAEL.CompactHeader.RecoverDamage"}}</span>
        <span><kbd>{{localize "ASTRAEL.CompactHeader.RightClick"}}</kbd>{{localize "ASTRAEL.CompactHeader.SuperficialDamage"}}</span>
        <span><kbd>Shift + {{localize "ASTRAEL.CompactHeader.RightClick"}}</kbd>{{localize "ASTRAEL.CompactHeader.AggravatedDamage"}}</span>
        <button type="button" data-action="set-compact-resource-tooltips" data-disabled="true"><i class="fas fa-eye-slash" aria-hidden="true"></i>{{localize "ASTRAEL.CompactHeader.DisableControlHints"}}</button>
      </aside>
      {{/if}}
    </section>
  </main>
</form>
